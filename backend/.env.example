# Copy to .env.development (or .env.production) and fill in.
SECRET_KEY=replace-with-a-long-random-string

# PostgreSQL (set DB_ENGINE=sqlite to skip Postgres for a quick try-out)
DB_ENGINE=postrges
DB_NAME=leave_portal_db
DB_USER=leave_portal_user
DB_PASSWORD=LeavePortal@2026
DB_HOST=localhost
DB_PORT=5432

FRONTEND_URL=http://localhost:5173

# Brevo SMTP. Leave blank in development to print emails in the console.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# Production only: comma-separated hosts
ALLOWED_HOSTS=
